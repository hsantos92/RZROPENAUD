#!/usr/bin/env python3
"""Executable launcher for RZROPENAUD-IO."""

import os
import sys

pkg_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
venv_python = os.path.join(pkg_root, ".venv", "bin", "python3")

# Auto re-exec into local .venv if system python lacks hid and .venv exists
if os.path.exists(venv_python) and sys.executable != venv_python:
    try:
        import hid  # noqa: F401
    except ImportError:
        os.execv(venv_python, [venv_python] + sys.argv)

if pkg_root not in sys.path:
    sys.path.insert(0, pkg_root)

from rzropenaud_io.cli import main

if __name__ == "__main__":
    sys.exit(main())
